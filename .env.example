# The platform's settings: copy to .env (never committed) and fill in. The API
# and the worker both read .env beside them; anything already set in the
# environment wins. Values with $, & or # go in single quotes.
#
# The API needs the first two blocks; the worker, the first and the last, and
# TINIO_KEY from the API's block to use the accounts owners connect.

# --- Both ---------------------------------------------------------------------

# The platform's one Postgres, password included. Use a role that isn't a
# superuser in production: a superuser skips the row-level security that keeps
# each account to its own agents.
DATABASE_URL=postgres://postgres:dev@localhost:5434/tinio?sslmode=disable

# --- The API (go run ./api) ---------------------------------------------------

# Signs sign-in codes and sessions: 32+ characters (openssl rand -hex 32).
# Changing it signs everyone out.
SIGNIN_SECRET=

# Where the app is: the API takes requests that change anything only from it.
APP_ORIGIN=http://localhost:3001

# false only for plain http on localhost; production cookies are secure.
COOKIE_SECURE=false

# true lets 000000 stand in for the emailed sign-in code, for development. The
# API won't start with it unless COOKIE_SECURE=false and APP_ORIGIN is localhost.
SIGNIN_DEV_CODE=false

# PORT=8081
# Proxies whose X-Forwarded-For is believed, comma-separated.
# TRUSTED_PROXIES=127.0.0.1,::1

# Seals the tokens of the accounts owners connect (Google, Atlassian); the
# worker needs the same key to use them. 64 hex characters: openssl rand -hex 32.
TINIO_KEY=
# Tinio's own Google client, for connecting Google. Its redirect URI is
# APP_ORIGIN/api/v1/connections/callback. The API key and project number are
# for Google's file picker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_API_KEY=
# GOOGLE_APP_ID=

# --- The worker (go run ./api worker) -----------------------------------------

# The platform's OpenAI key: System 1, System 2, embeddings and web search.
OPENAI_API_KEY=

# System 2, which writes every reply: gpt-6.1-terra, gpt-6.1-sol, gpt-6-luna, ...
OPENAI_MODEL=gpt-6.1-terra

# System 1, the decisions. Empty: gpt-6-luna, the only one the Decisions API has.
OPENAI_DECISION_MODEL=

# Their own day (planning, learning, what they watch, the weekly review).
# Empty: OPENAI_MODEL. gpt-6-luna makes a day cost about a cent.
OPENAI_DAY_MODEL=gpt-6-luna

# Replies once an account's week is used (light mode). Empty: gpt-6-luna.
# OPENAI_LIGHT_MODEL=gpt-6-luna

# Making works, for themselves or someone (what they write in an activity or
# promised, and a work's data, like a MIDI score). Empty: OPENAI_MODEL.
OPENAI_WORK_MODEL=

# Most agents one worker runs at once; owners writing are taken past it.
# MAX_AGENTS=20000
