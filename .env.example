# Tinio's settings: copy to .env beside the tinio binary (never committed) and
# fill in what you need. Anything already set in the environment wins. Values
# with $, & or # go in single quotes. Nothing here is needed: your OpenAI key
# is set in the app, and the rest have defaults.

# --- Your keys ----------------------------------------------------------------

# Your OpenAI key: System 1, System 2 and embeddings. Better set in the app,
# where it's kept sealed; one set here is used instead.
# OPENAI_API_KEY=

# System 2, which writes every reply. Empty: gpt-6.1-terra. Also gpt-6.1-sol, gpt-6-luna, ...
# OPENAI_MODEL=gpt-6.1-terra

# System 1, the decisions. Empty: gpt-6-luna, the only one the Decisions API has.
# OPENAI_DECISION_MODEL=

# Their own day (planning, learning, what they watch, the weekly review).
# Empty: gpt-6-luna, which makes a day cost about a cent.
# OPENAI_DAY_MODEL=gpt-6-luna

# Replies once the week's spending is used (light mode). Empty: gpt-6-luna.
# OPENAI_LIGHT_MODEL=gpt-6-luna

# Making works, for themselves or someone (what they write in an activity or
# promised, and a work's data, like a MIDI score). Empty: OPENAI_MODEL.
# OPENAI_WORK_MODEL=

# --- Where it runs ------------------------------------------------------------

# The folder with Tinio's database and its key. Empty: Application Support on
# macOS, %AppData% on Windows, ~/.local/share/tinio elsewhere.
# TINIO_DATA=

# Where it listens. Empty: this machine only, on port 8081.
# TINIO_ADDR=127.0.0.1:8081

# Lets another device (your phone on the same Wi-Fi) in, with TINIO_ADDR set
# to listen there too: 16 characters or more. Empty: this machine only, which
# never needs one.
# TINIO_PASSCODE=

# Seals every key and token kept. Empty: Tinio makes one the first time it
# runs and keeps it in the data folder; set this only to use one of your own
# (64 hex characters). Lose it and what it sealed can't be opened again.
# TINIO_KEY=

# Where the app is: the API takes requests that change anything only from it.
APP_ORIGIN=http://localhost:3001

# true only when it's served over https.
# COOKIE_SECURE=false

# Proxies whose X-Forwarded-For is believed, comma-separated.
# TRUSTED_PROXIES=127.0.0.1,::1

# Most agents it runs at once; owners writing are taken past it.
# MAX_AGENTS=20000

# --- Connections --------------------------------------------------------------

# A Google client, for connecting Google. Its redirect URI is
# APP_ORIGIN/api/v1/connections/callback. The API key and project number are
# for Google's file picker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_API_KEY=
# GOOGLE_APP_ID=
